{
  "name": "viraaz-server",
  "version": "1.0.0",
  "description": "Viraaz (ویراژ) — online book & magazine store, Node.js/Express backend with JSON file storage",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run build && node --watch dist/index.js",
    "start": "node dist/index.js",
    "build": "node ./node_modules/typescript/bin/tsc",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.7",
    "express": "^4.21.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
