PORT=4000
NODE_ENV=development
# Comma-separated allowed origins for CORS (no spaces)
CORS_ORIGINS=http://localhost:5173,http://localhost:4000
# Development-only admin password for the local admin panel demo.
# NEVER commit a real password here. This is NOT production security.
ADMIN_PASSWORD=dev-admin-1234
# JSON data directory (defaults to src/data)
DATA_DIR=
